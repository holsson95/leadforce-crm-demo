# Copy to .env.local and fill in real values for local development.
# For the public demo deployment, set these as Vercel project env vars instead.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=<your-clerk-secret-key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
CLERK_WEBHOOK_SECRET=<your-clerk-webhook-secret>

# --- Database (Postgres — Supabase/Neon both work) ---
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- AI (used for the company-summary feature) ---
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Cron auth (shared by /api/cron/purge-campaigns and /api/cron/reset-demo) ---
# Vercel sets `Authorization: Bearer $CRON_SECRET` automatically on its own
# Cron Job requests once this is set as a project env var — no extra config.
CRON_SECRET=choose-a-long-random-string

# --- Public demo build only ---
# One real Clerk account, created once by hand in the Clerk dashboard, that
# every visitor shares via the "View Demo" button (src/app/(auth)/sign-in).
# It has no real personal data behind it, so a public email/password is fine.
#   1. Create the Clerk user (any email/password you choose).
#   2. Set its publicMetadata to { "role": "admin", "tenantId": "<acme-outreach-tenant-id>" }
#      — get the tenant id by running `npm run db:seed:demo` first and reading its output.
#   3. Copy its Clerk user ID into DEMO_USER_CLERK_ID below, then re-run the seed
#      so it gets a User row under both demo tenants.
NEXT_PUBLIC_DEMO_EMAIL=demo@your-domain.example
NEXT_PUBLIC_DEMO_PASSWORD=choose-a-password
DEMO_USER_CLERK_ID=user_xxxxxxxxxxxxxxxxxxxxxxxx
